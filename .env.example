# LLM API (TrollLLM proxy for Claude)
ANTHROPIC_API_KEY=your-api-key-here
ANTHROPIC_BASE_URL=https://chat.trollllm.xyz
CLAUDE_MODEL=claude-opus-4-6
OPENAI_API_KEY=your-openai-compatible-api-key-here
OPENAI_BASE_URL=https://chat.trollllm.xyz/v1
OPENAI_USER_AGENT=rag-system/1.0
LLM_MODEL=claude-sonnet-4-6

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ENVIRONMENT=development
CORS_ALLOWED_ORIGINS=*
JWT_SECRET_KEY=change-this-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=admin123

# PostgreSQL
DATABASE_URL=postgresql://raguser:ragpass@localhost:5432/rag_db

# Qdrant Vector DB
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=documents

# MinIO Object Storage
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=documents
MINIO_SECURE=False

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# RAG Configuration
CHUNK_SIZE=500
CHUNK_OVERLAP=100
RAG_CHUNK_MIN_CHARS=120
RAG_DEDUP_CHUNKS=true
RETRIEVAL_TOP_K=5
USE_RERANKER=False
MIN_RELEVANCE_SCORE=0.0
MAX_CONTEXT_CHUNKS=8
MAX_SOURCES_IN_ANSWER=5
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIM=384
EMBEDDING_BATCH_SIZE=32
EMBEDDING_DEVICE=cpu
PRELOAD_EMBEDDING_ON_STARTUP=False
OCR_ENABLED=true
OCR_LANGS=eng+vie
OCR_DPI=200
OCR_MIN_TEXT_CHARS=1
PDF_MIN_PAGES_FOR_TEXT_GUARD=8
PDF_EMPTY_PAGE_RATIO_THRESHOLD=0.7

# File Upload
MAX_UPLOAD_SIZE_MB=50

# Docker Hub (only needed if YOU are pushing images, not required to run)
# DOCKER_USER=your-dockerhub-username

# Monitoring
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin123

# Backup scheduler
BACKUP_INTERVAL_SECONDS=86400

# SSL / domain (optional)
DOMAIN=example.com
