# App environment: development | production
APP_ENV=development

# Required: Google API key for embeddings + LLM
GOOGLE_API_KEY=your_google_api_key_here

# JWT/Auth
# Use a random value with >= 32 characters
SECRET_KEY=replace_with_a_strong_random_secret_key_min_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS (comma-separated origins)
# Example: http://localhost,http://127.0.0.1,http://localhost:3000
CORS_ALLOW_ORIGINS=http://localhost,http://127.0.0.1

# Default admin account (must be changed before production)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_this_default_admin_password
ADMIN_FULL_NAME=Default Admin

# PostgreSQL
DB_HOST=postgres
DB_PORT=5432
DB_NAME=rag_db
DB_USER=rag_user
DB_PASS=rag_pass

# MinIO
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minio
MINIO_SECRET_KEY=miniopass
MINIO_BUCKET=documents

# Qdrant / RAG
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=rag_collection
EMBEDDING_MODEL=models/gemini-embedding-001
EMBEDDING_DIMENSION=768
EMBEDDING_BATCH_SIZE=100
RAG_CHUNK_SIZE=400
RAG_CHUNK_OVERLAP=100
RAG_TOP_K=3
LLM_MODEL=gemini-2.5-flash
RAG_STAGING_DIR=/tmp/rag-staging

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_MAX_RETRIES=5
CELERY_RETRY_BACKOFF_BASE_SECONDS=5
CELERY_RETRY_BACKOFF_MAX_SECONDS=120
INGEST_LOCK_TTL_SECONDS=3600
