# LLM API (TrollLLM proxy for Claude)
ANTHROPIC_API_KEY=sk-trollllm-ffce4f9069dbcc26e3b1a9d2691c10ead4aa5aaacb4ee1eaf22456d570991a94
ANTHROPIC_BASE_URL=https://chat.trollllm.xyz
CLAUDE_MODEL=claude-opus-4-6

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ENVIRONMENT=development

# PostgreSQL
DATABASE_URL=postgresql://raguser:ragpass@localhost:5432/rag_db

# Qdrant Vector DB
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=documents

# MinIO Object Storage
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=documents
MINIO_SECURE=False

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# RAG Configuration
CHUNK_SIZE=500
CHUNK_OVERLAP=100
# Default chunks per query. Raised from 5 -> 8: 5 was too narrow for
# synthesis questions ("summarize", "main themes"). The backend auto-widens
# this further when it detects a broad question.
RETRIEVAL_TOP_K=8
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# Bigger budget so synthesis answers aren't truncated.
CLAUDE_MAX_TOKENS=4000

# File Upload
MAX_UPLOAD_SIZE_MB=100

# Docker Hub (only needed if YOU are pushing images, not required to run)
# DOCKER_USER=your-dockerhub-username