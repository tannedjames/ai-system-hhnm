# =============================================================================
# RAG System — Environment Variables
# =============================================================================
# Copy this file:  cp .env.example .env
# Then customize values for your environment.
# =============================================================================

# --- PostgreSQL ---
POSTGRES_USER=rag_user
POSTGRES_PASSWORD=rag_password
POSTGRES_DB=rag_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=rag_redis_pass

# --- MinIO (S3-compatible Object Storage) ---
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=minio_secret_123
MINIO_HOST=localhost
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET_NAME=rag-documents
MINIO_SECURE=false

# --- Qdrant (Vector Database) ---
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334

# --- Celery ---
CELERY_BROKER_URL=redis://:rag_redis_pass@localhost:6379/0
CELERY_RESULT_BACKEND=redis://:rag_redis_pass@localhost:6379/1

# --- FastAPI ---
APP_NAME=RAG Knowledge Base System
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# --- Ollama ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=qwen3.5:4b

# --- Qwen Models ---
EMBEDDING_MODEL_NAME=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_DIM=1024
SPARSE_MODEL_NAME=Qdrant/bm25
RERANKER_MODEL_NAME=Qwen/Qwen3-Reranker-0.6B

# --- Qdrant Collection ---
QDRANT_COLLECTION=rag_documents

# --- Microservice URLs ---
EMBEDDING_SERVICE_URL=http://localhost:8001
RERANKER_SERVICE_URL=http://localhost:8002
RAG_SERVICE_URL=http://localhost:8003
